{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user financial workspace profile and notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the dashboard."
        },
        "primaryCurrency": {
          "type": "string",
          "enum": ["RWF", "USD"],
          "description": "User's primary reporting currency."
        },
        "monthlyIncomeTarget": {
          "type": "number",
          "description": "User's monthly income target in primary currency."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether initial workspace onboarding wizard has been completed."
        },
        "budgetThresholdPct": {
          "type": "number",
          "description": "Default monthly budget warning threshold percentage (10-100)."
        },
        "categoryThresholds": {
          "type": "object",
          "description": "Per-category custom budget warning threshold percentages."
        },
        "customCategoriesIncome": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User-created custom income categories."
        },
        "customCategoriesExpense": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User-created custom expense categories."
        },
        "savedTags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "User-saved transaction tags."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "primaryCurrency",
        "monthlyIncomeTarget",
        "onboardingCompleted",
        "budgetThresholdPct",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkedAccount": {
      "title": "LinkedAccount",
      "description": "User's configured financial account slot (Cash, Bank, Mobile Money, Savings, FX).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "status": { "type": "string" },
        "providerLabel": { "type": "string" },
        "openingBalance": { "type": "number" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "name",
        "type",
        "currency",
        "status",
        "providerLabel",
        "openingBalance",
        "enabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Recorded income or expense ledger entry with optional tags and recurring schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "referenceNo": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "category": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurringFrequency": {
          "type": "string",
          "enum": ["none", "daily", "weekly", "monthly"]
        },
        "nextOccurrenceDate": { "type": "string" },
        "goalId": { "type": "string", "maxLength": 128 },
        "goalName": { "type": "string", "maxLength": 100 },
        "originalCurrency": { "type": "string", "maxLength": 6 },
        "originalAmount": { "type": "number" },
        "exchangeRate": { "type": "number" },
        "rateTimestamp": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "referenceNo",
        "idempotencyKey",
        "type",
        "accountId",
        "accountName",
        "currency",
        "category",
        "tags",
        "amount",
        "date",
        "description",
        "isRecurring",
        "recurringFrequency",
        "nextOccurrenceDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetAllocation": {
      "title": "BudgetAllocation",
      "description": "Monthly category spending allocation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "category": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "category",
        "monthlyLimit",
        "enabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User financial goal with target amount, linked account or category, and transaction-driven progress.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "targetDate": { "type": "string", "maxLength": 10 },
        "linkedAccountId": { "type": "string", "maxLength": 80 },
        "linkedAccountName": { "type": "string", "maxLength": 80 },
        "linkedCategory": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "name",
        "targetAmount",
        "currentAmount",
        "currency",
        "targetDate",
        "linkedAccountId",
        "linkedAccountName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduledBill": {
      "title": "ScheduledBill",
      "description": "Upcoming or recurring scheduled bill reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "dueDate": { "type": "string" },
        "paid": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "title",
        "amount",
        "currency",
        "dueDate",
        "paid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountUpdate": {
      "title": "AccountUpdate",
      "description": "Audit event for account linking, opening balance setup, and budget configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "timestamp": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["account_linked", "balance_initialized", "budget_configured"]
        },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "accountName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "timestamp",
        "kind",
        "title",
        "detail",
        "accountName",
        "amount",
        "currency",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetAlert": {
      "title": "BudgetAlert",
      "description": "Persisted monthly category spending threshold alert (>90% of budget) and push dispatch state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 60 },
        "monthKey": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "spentAmount": { "type": "number" },
        "budgetLimit": { "type": "number" },
        "utilizationPct": { "type": "number" },
        "thresholdPct": { "type": "number" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "status": {
          "type": "string",
          "enum": ["warning_90", "exceeded_100", "acknowledged"]
        },
        "pushDispatched": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "category",
        "monthKey",
        "spentAmount",
        "budgetLimit",
        "utilizationPct",
        "thresholdPct",
        "currency",
        "status",
        "pushDispatched",
        "createdAt",
        "updatedAt"
      ]
    },
    "DebtAccount": {
      "title": "DebtAccount",
      "description": "Outstanding loan or credit card liability with repayment tracking and payoff schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "debtType": {
          "type": "string",
          "enum": ["loan", "credit_card", "mortgage", "other"]
        },
        "lender": { "type": "string", "maxLength": 80 },
        "originalAmount": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "aprPct": { "type": "number" },
        "minimumMonthlyPayment": { "type": "number" },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "name",
        "debtType",
        "lender",
        "originalAmount",
        "remainingBalance",
        "aprPct",
        "minimumMonthlyPayment",
        "currency",
        "createdAt",
        "updatedAt"
      ]
    },
    "BudgetForecast": {
      "title": "BudgetForecast",
      "description": "Saved AI-driven spending and monthly budget needs forecast grounded in historical patterns.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "currency": { "type": "string", "enum": ["RWF", "USD"] },
        "horizonMonths": { "type": "number" },
        "modelName": { "type": "string", "maxLength": 60 },
        "totalRecommendedMonthlyBudget": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["low", "moderate", "elevated"] },
        "aiSummary": { "type": "string", "maxLength": 600 },
        "forecastMonthsJson": { "type": "string", "maxLength": 8000 },
        "categoryRecommendationsJson": { "type": "string", "maxLength": 12000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "currency",
        "horizonMonths",
        "modelName",
        "totalRecommendedMonthlyBudget",
        "confidenceScore",
        "riskLevel",
        "aiSummary",
        "forecastMonthsJson",
        "categoryRecommendationsJson",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and financial workspace settings."
    },
    "users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/LinkedAccount" },
      "description": "Owner-only configured financial accounts."
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Owner-only ledger transactions."
    },
    "users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/BudgetAllocation" },
      "description": "Owner-only monthly category budgets."
    },
    "users/{userId}/savingsGoals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "Owner-only savings goals."
    },
    "users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/ScheduledBill" },
      "description": "Owner-only scheduled bills."
    },
    "users/{userId}/accountUpdates/{updateId}": {
      "schema": { "$ref": "#/entities/AccountUpdate" },
      "description": "Owner-only account & budget configuration activity log."
    },
    "users/{userId}/budgetAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/BudgetAlert" },
      "description": "Owner-only monthly category spending threshold alerts (>90%) and push notification records."
    },
    "users/{userId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/DebtAccount" },
      "description": "Owner-only outstanding loans and credit cards tracked for payoff."
    },
    "users/{userId}/budgetForecasts/{forecastId}": {
      "schema": { "$ref": "#/entities/BudgetForecast" },
      "description": "Owner-only saved AI-driven future monthly budget forecasts."
    }
  }
}
